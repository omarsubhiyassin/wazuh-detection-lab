# Copy to dashboard/.env (gitignored). The BFF reads these; the browser never
# sees the indexer credentials.

# Indexer (OpenSearch) endpoint and the READ-ONLY service account.
INDEXER_URL=https://localhost:9200
INDEXER_RO_USER=detectionlab_ro
INDEXER_RO_PASSWORD=CHANGE_ME_readonly_password

# Alerts index pattern and BFF port.
ALERTS_INDEX=wazuh-alerts-*
PORT=8787

# Dashboard login. Two options:
#  (a) single admin — set DASH_PASSWORD_HASH (npm run hash-password). Fail-closed
#      until set. DASH_USER names that account.
#  (b) multiple users with roles (viewer/analyst/admin) — run `npm run add-user`,
#      which writes dashboard/users.json (gitignored). users.json takes
#      precedence over DASH_USER/DASH_PASSWORD_HASH when present.
DASH_USER=admin
DASH_PASSWORD_HASH=
# Override the default paths for the RBAC directory + SOC-ops state (all
# gitignored, default to the dashboard/ dir):
#DASH_USERS_FILE=./users.json
#DASH_TRIAGE_FILE=./triage-state.json
#DASH_AUDIT_FILE=./audit.log
#DASH_FINDINGS_FILE=./ai-findings.json
# Custom ruleset, read to show which ATT&CK techniques we actually have
# detections for (default: ../detections/rules/local_rules.xml).
#DASH_RULES_FILE=../detections/rules/local_rules.xml
#
# Triage record retention. OPEN records whose alert has aged out of the indexer
# are unactionable and inflate the queue counts, so they are pruned — keep this
# in sync with ALERTS_RETENTION_DAYS in infra/.env.
#DASH_ALERT_RETENTION_DAYS=30
# CLOSED records are the detection-efficacy history and are kept forever by
# default (0). Set a number of days only if you want them to expire too.
#DASH_CLOSED_RETENTION_DAYS=0
# Session lifetime in hours (default 12).
#DASH_SESSION_TTL_HOURS=12
# TLS for the BFF itself (bootstrap generates the pair and fills these in the
# deployed .env). When set, the BFF serves HTTPS; leave unset for plain-HTTP dev.
#DASH_TLS_CERT=/path/to/dashboard.pem
#DASH_TLS_KEY=/path/to/dashboard-key.pem
# Set true when the dashboard is served over HTTPS (adds Secure to the cookie).
#DASH_COOKIE_SECURE=true

# --- AI-assisted triage (advisory only) ---------------------------------------
# The ranking is a deterministic weighted score and needs no configuration and
# no API key. These only tune it:
#   AI_MIN_LEVEL       ignore alerts below this rule level (default 8)
#   AI_FLAG_THRESHOLD  score at which an alert gets flagged for review (default 45)
#AI_MIN_LEVEL=8
#AI_FLAG_THRESHOLD=45
#
# OPTIONAL: let Claude draft a short analyst-facing rationale on top of the
# score. Off by default — the feature works fully without it. Turning it on
# sends alert metadata and a truncated log excerpt to the Anthropic API, so only
# enable it if that is acceptable for your data. Requires `npm i @anthropic-ai/sdk`
# and ANTHROPIC_API_KEY. Model output never changes the score, the ranking, or
# any triage state.
#AI_LLM_ENABLED=false
#AI_LLM_MODEL=claude-opus-5
#AI_LLM_MAX_SUMMARIES=5
#ANTHROPIC_API_KEY=
