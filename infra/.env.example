# Copy to .env and change every value. .env is gitignored — never commit real secrets.

# --- Pinned Wazuh stack version ---
# Git tag in wazuh/wazuh-docker (has a 'v' prefix) — used by bootstrap to clone.
WAZUH_DOCKER_TAG=v4.14.6
# Docker Hub image tag (NO 'v' prefix) — used for the agent image. Keep in sync
# with WAZUH_DOCKER_TAG minus the leading 'v'.
WAZUH_IMAGE_TAG=4.14.6

# --- Absolute path to THIS repo root, as seen from the Docker host (WSL) ---
# Used by docker-compose.override.yml to bind-mount custom rules/decoders and
# generator output into the manager/agent containers.
# IMPORTANT: for file-tailing to work reliably, this must be on the Linux (WSL)
# filesystem, NOT /mnt/c/...  (inotify events are unreliable across the 9p mount).
# e.g. /home/youruser/detection-lab
DETECTION_LAB_ROOT=/home/CHANGEME/detection-lab

# --- Wazuh indexer admin credentials ---
# bootstrap.sh DRIVES the real indexer password from this value: on first run it
# bcrypt-hashes it, patches the vendored internal_users.yml, pushes it with
# securityadmin.sh, and recreates the clients with the new env. The vendored
# default (SecretPassword) is refused unless ALLOW_DEFAULT_CREDS=true.
# Indexer policy: 8+ chars with upper/lower/digit/special.
INDEXER_USERNAME=admin
INDEXER_PASSWORD=CHANGE_ME_admin_password

# --- Wazuh dashboard service account (rotated by bootstrap the same way) ---
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=CHANGE_ME_kibanaserver_password

# --- Wazuh API account (wazuh-wui) — rotated by bootstrap via the manager API ---
# Used by the built-in dashboard to talk to the manager (port 55000).
# Policy: 8-64 chars with upper/lower/digit/symbol. Avoid quotes, backslashes
# and spaces in ALL passwords here (they are embedded in shell/JSON).
API_USERNAME=wazuh-wui
API_PASSWORD=CHANGE_ME_api_password

# --- Read-only service account for the CUSTOM dashboard to query the indexer ---
# Created/updated by bootstrap via the security REST API.
CUSTOM_DASHBOARD_RO_USER=detectionlab_ro
CUSTOM_DASHBOARD_RO_PASSWORD=CHANGE_ME_strong_password

# --- Agent enrollment password (authd) ---
# bootstrap writes this to the manager's authd.pass and flips <use_password> on,
# so only agents presenting it can enroll. The compose Linux agent gets it
# automatically (WAZUH_REGISTRATION_PASSWORD).
AGENT_ENROLLMENT_PASSWORD=CHANGE_ME_enrollment_password

# --- Slack notifications (Wazuh integrator), applied by bootstrap ---
# Create an Incoming Webhook in your Slack workspace (api.slack.com/apps ->
# Incoming Webhooks) and paste its URL. Empty = notifications disabled
# (bootstrap also removes a previously configured webhook when this is empty).
SLACK_WEBHOOK_URL=
# Alerts at/above this level are sent to Slack (12 = critical band).
NOTIFY_MIN_LEVEL=12

# --- Self-monitoring (healthcheck.sh, cron every 5 min via bootstrap) ---
# Posts to SLACK_WEBHOOK_URL on failure/recovery. Checks: containers up,
# indexer green, filebeat shipping, an agent Active, disk below threshold.
DISK_ALERT_PCT=80
# Also alert when no new alerts were indexed for N hours (0 = off; leave off
# unless a steady event stream is expected).
EVENT_STALL_HOURS=0
# While still failing, re-post a reminder every N hours.
REMIND_HOURS=6

# --- Backups (backup.sh daily via cron; restore.sh to drill/restore) ---
# Holds SECRETS (agent keys, .env copies) — keep outside the repo, mode 600.
BACKUP_DIR=/var/tmp/detection-lab-backups
# Keep the newest N snapshots and manager-state tarballs.
BACKUP_KEEP=14

# --- Active response (auto-block brute-force sources), applied by bootstrap ---
# Blocks the source IP of an SSH brute-force attempt via the agent's local
# firewall (Wazuh's built-in firewall-drop). OFF by default: a false positive
# here blocks a real source, so this is a deliberate opt-in, not a default-on
# feature like retention/Slack. Review ACTIVE_RESPONSE_ALLOWLIST before enabling.
ACTIVE_RESPONSE_ENABLED=false
# Rule IDs that trigger a block. Defaults are the built-in SSH brute-force
# detections (same_source_ip + repeated auth failure), which fire BEFORE any
# successful login — add 100400 (our post-compromise composite) to also
# block a source that already got in, if you want that.
ACTIVE_RESPONSE_RULES=5712,5763
# Auto-unblock after this many seconds — a fail-safe so a false positive
# (or a shared/NAT'd IP) doesn't stay blocked forever.
ACTIVE_RESPONSE_TIMEOUT=600
# Comma-separated IPs/CIDRs that must NEVER be blocked, in addition to the
# loopback + internal Docker network bootstrap always exempts. Put your own
# management IP / VPN range / office egress IP here before enabling.
ACTIVE_RESPONSE_ALLOWLIST=

# --- Retention / index lifecycle (ISM), applied by bootstrap ---
# Daily indices are deleted this many days after creation. 0 = don't manage.
ALERTS_RETENTION_DAYS=90
# Internal telemetry (wazuh-monitoring-*, wazuh-statistics-*) — safe to keep short.
INTERNAL_RETENTION_DAYS=30

# --- JVM heap caps (keep the indexer from eating all of WSL's RAM) ---
# Rule of thumb: ~50% of RAM you gave WSL2, max 2g each for a lab.
INDEXER_JAVA_OPTS="-Xms2g -Xmx2g"

# --- Agent enrollment ---
WAZUH_MANAGER_HOST=wazuh.manager
