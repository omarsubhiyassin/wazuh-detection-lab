<!--
  Custom detection rules (detection-as-code) for the detection lab.

  Custom rule IDs use the 100000+ range. Every detection carries a
  <mitre><id>Txxxx</id></mitre> block and has a sample + expected result under
  detections/tests/. Field names below were confirmed with `wazuh-logtest`
  against the generator's output (all our events decode via the `json` decoder).

  Layering: these are per-event SIGNATURE rules (Phase 3). Frequency/correlation
  rules (e.g. brute-force->success composite, DNS-beacon regularity) are Phase 4.

  Rule map:
    100100  Sysmon process creation (Event ID 1) .............. base (level 0)
    100101   -> Encoded PowerShell command line ............... T1059.001
    100110   -> Scheduled task created via schtasks.exe ....... T1053.005
    100120  Security 4698: scheduled task registered .......... T1053.005 (base)
    100121   -> ...launching a suspicious interpreter ......... T1053.005
    100300  DNS TXT query w/ long hex subdomain (tunneling) ... T1071.004
-->

<!-- ===================== Execution / Persistence (Sysmon) ==================== -->
<group name="detection_lab,sysmon,windows,">

  <rule id="100100" level="0">
    <decoded_as>json</decoded_as>
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID" type="pcre2">^1$</field>
    <description>Sysmon: process creation (Event ID 1).</description>
  </rule>

  <rule id="100101" level="12">
    <if_sid>100100</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-e[a-z]*\s+[A-Za-z0-9+/=]{30,}</field>
    <description>Encoded PowerShell command line executed (possible obfuscated payload).</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100110" level="10">
    <if_sid>100100</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create</field>
    <description>Scheduled task created via schtasks.exe (possible persistence).</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

</group>

<!-- ===================== Persistence (Security 4698) ========================= -->
<group name="detection_lab,windows,security,">

  <rule id="100120" level="8">
    <decoded_as>json</decoded_as>
    <field name="win.system.eventID" type="pcre2">^4698$</field>
    <description>Windows: a scheduled task was created (Security 4698).</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <rule id="100121" level="12">
    <if_sid>100120</if_sid>
    <field name="win.eventdata.taskContent" type="pcre2">(?i)powershell|pwsh|-enc|cmd\.exe|\.ps1|downloadstring|net\.webclient|invoke-expression</field>
    <description>Scheduled task registered to launch a suspicious interpreter/command.</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

</group>

<!-- ===================== Command and Control (DNS tunneling) ================= -->
<group name="detection_lab,suricata,dns,">

  <rule id="100300" level="10">
    <if_group>suricata</if_group>
    <field name="dns.rrtype">TXT</field>
    <field name="dns.rrname" type="pcre2">^[a-f0-9]{16,}\.</field>
    <description>Suspicious DNS TXT query with long hex subdomain (possible DNS tunneling / C2).</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
  </rule>

</group>

<!-- ===================== Phase 4: correlation / composite ==================== -->

<!-- SSH brute force -> successful login from the SAME source IP (compromise). -->
<group name="detection_lab,syslog,sshd,">

  <rule id="100400" level="12" timeframe="300">
    <if_sid>5715</if_sid>
    <if_matched_sid>5712</if_matched_sid>
    <same_source_ip />
    <description>SSH: successful login from an IP that was just brute-forcing (likely account compromise).</description>
    <mitre>
      <id>T1078</id>
      <id>T1110</id>
    </mitre>
  </rule>

</group>

<!-- DNS beaconing: aggregate repeated tunneling queries from one host into a
     single high-fidelity alert instead of one per query. -->
<group name="detection_lab,suricata,dns,">

  <rule id="100410" level="12" frequency="8" timeframe="600">
    <if_matched_sid>100300</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>DNS beaconing: repeated long-subdomain TXT queries from one host (possible C2 over DNS).</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
  </rule>

</group>

<!-- Kill chain: encoded PowerShell execution followed by scheduled-task
     persistence on the SAME host within a short window. Correlates on
     win.system.computer (all Windows events arrive via one agent, so the agent
     name can't distinguish hosts). Tight timeframe so independent scenarios that
     merely happen on the same host don't look like a chain. -->
<group name="detection_lab,windows,killchain,">

  <rule id="100420" level="13" timeframe="600">
    <if_sid>100121</if_sid>
    <if_matched_sid>100101</if_matched_sid>
    <same_field>win.system.computer</same_field>
    <description>Kill chain: encoded PowerShell execution then scheduled-task persistence on the same host.</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1053.005</id>
    </mitre>
  </rule>

</group>
