<!--
  Custom detection rules (detection-as-code) for the detection lab.

  Custom rule IDs use the 100000+ range. Every detection carries a
  <mitre><id>Txxxx</id></mitre> block and has a sample + expected result under
  detections/tests/.

  DUAL-DECODER: Windows detections fire for BOTH real endpoints (Sysmon/Security
  via the windows_eventchannel decoder, anchored on the built-in sysmon_eventN /
  Security base rules) AND the synthetic generator regression suite (json
  decoder). Each detection lists both base rule IDs in <if_sid> (comma = OR).
  Verified: rule 100101 fires on a real enrolled Windows host end-to-end.

  Layering: these are per-event SIGNATURE rules (Phase 3). Frequency/correlation
  rules (e.g. brute-force->success composite, DNS-beacon regularity) are Phase 4.

  Rule map:
    100100  Sysmon process creation (Event ID 1) .............. base (level 0)
    100101   -> Encoded PowerShell command line ............... T1059.001
    100110   -> Scheduled task created via schtasks.exe ....... T1053.005
    100120  Security 4698: scheduled task registered .......... T1053.005 (base)
    100121   -> ...launching a suspicious interpreter ......... T1053.005
    100300  DNS TXT query w/ long hex subdomain (tunneling) ... T1071.004
-->

<!-- ===================== Execution / Persistence (Sysmon) ==================== -->
<group name="detection_lab,sysmon,windows,">

  <!-- DUAL BASE RULES per Sysmon event type so detections fire for BOTH:
        * real endpoints — events decoded by windows_eventchannel land in the
          built-in sysmon_eventN groups, matched via <if_group>;
        * the synthetic generator (regression suite) — events decoded by the
          json decoder, matched via <decoded_as>json</decoded_as> + fields.
       Each detection lists both base IDs in <if_sid> (comma = OR), so one rule
       body covers real and generator alike. The earlier field-only base was
       never evaluated for eventchannel events (Wazuh only tests them against
       rules anchored into the sysmon group tree). -->
  <rule id="100100" level="0">
    <if_group>sysmon_event1</if_group>
    <description>Sysmon: process creation (EID 1) — real eventchannel.</description>
  </rule>
  <rule id="100105" level="0">
    <decoded_as>json</decoded_as>
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID" type="pcre2">^1$</field>
    <description>Sysmon: process creation (EID 1) — generator json.</description>
  </rule>

  <rule id="100101" level="12">
    <if_sid>100100,100105</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s-e[a-z]*\s+[A-Za-z0-9+/=]{30,}</field>
    <description>Encoded PowerShell command line executed (possible obfuscated payload).</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
  </rule>

  <rule id="100110" level="10">
    <if_sid>100100,100105</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)/create</field>
    <description>Scheduled task created via schtasks.exe (possible persistence).</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <rule id="100200" level="0">
    <if_group>sysmon_event3</if_group>
    <description>Sysmon: network connection (EID 3) — real eventchannel.</description>
  </rule>
  <rule id="100205" level="0">
    <decoded_as>json</decoded_as>
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID" type="pcre2">^3$</field>
    <description>Sysmon: network connection (EID 3) — generator json.</description>
  </rule>

</group>

<!-- ===================== Credential Access (LSASS dumping) ================== -->
<group name="detection_lab,sysmon,windows,credential_access,">

  <!-- Dual base for Sysmon EID10 (process access): real via sysmon_event_10,
       generator via json. -->
  <rule id="100710" level="0">
    <if_group>sysmon_event_10</if_group>
    <description>Sysmon: process access (EID 10) — real eventchannel.</description>
  </rule>
  <rule id="100715" level="0">
    <decoded_as>json</decoded_as>
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID" type="pcre2">^10$</field>
    <description>Sysmon: process access (EID 10) — generator json.</description>
  </rule>

  <!-- The read: a non-system process opens LSASS memory with read rights.
       Legit accessors (AV, wininit, svchost, ...) are allow-listed via negate,
       so this fires on the mask+target regardless of which tool is used. -->
  <rule id="100700" level="13">
    <if_sid>100710,100715</if_sid>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)\\lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">(?i)^0x(1010|1410|1418|1438|143a|1fffff)$</field>
    <field name="win.eventdata.sourceImage" negate="yes" type="pcre2">(?i)\\(wininit|csrss|services|lsass|MsMpEng|MpDefenderCoreService|SenseCncProxy|svchost)\.exe$</field>
    <description>Suspicious process accessed LSASS memory (credential dumping).</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

  <!-- The command: known LSASS-dump tooling / techniques on the command line. -->
  <rule id="100701" level="13">
    <if_sid>100100,100105</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-ma\s+lsass|procdump.{0,40}lsass|comsvcs\.dll.{0,20}minidump|rundll32.{0,40}minidump|sekurlsa|out-minidump|nanodump)</field>
    <description>LSASS credential-dump tooling on the command line.</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
  </rule>

</group>

<!-- ===================== Defense Evasion (log clearing) ===================== -->
<group name="detection_lab,windows,defense_evasion,">

  <!-- Dual base for Security 1102: real events chain off the Windows Security
       base rule 60100; generator events via json. -->
  <rule id="100610" level="0">
    <if_sid>60100</if_sid>
    <field name="win.system.eventID" type="pcre2">^1102$</field>
    <description>Security 1102 (audit log cleared) — real eventchannel.</description>
  </rule>
  <rule id="100615" level="0">
    <decoded_as>json</decoded_as>
    <field name="win.system.eventID" type="pcre2">^1102$</field>
    <description>Security 1102 (audit log cleared) — generator json.</description>
  </rule>

  <!-- The effect: Windows itself logs 1102 when the Security audit log is cleared. -->
  <rule id="100600" level="12">
    <if_sid>100610,100615</if_sid>
    <description>Windows Security audit log was cleared (indicator removal).</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
  </rule>

  <!-- The command: catches the clear even if 1102 auditing is disabled. -->
  <rule id="100601" level="12">
    <if_sid>100100,100105</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\wevtutil\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\s(cl|clear-log)\s</field>
    <description>Event log cleared via wevtutil (indicator removal).</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
  </rule>

</group>

<!-- ===================== Lateral Movement (PsExec) ========================== -->
<group name="detection_lab,sysmon,windows,lateral_movement,">

  <rule id="100500" level="12">
    <if_sid>100100,100105</if_sid>
    <field name="win.eventdata.parentImage" type="pcre2">(?i)\\PSEXESVC\.exe$</field>
    <description>Remote command execution via the PsExec service (lateral movement).</description>
    <mitre>
      <id>T1021.002</id>
    </mitre>
  </rule>

</group>

<!-- ===================== Persistence (Security 4698) ========================= -->
<group name="detection_lab,windows,security,">

  <!-- Dual base for Security 4698: real 4698 is an audit-success event, so it
       chains off built-in rule 60103; generator events via json. -->
  <rule id="100120" level="8">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID" type="pcre2">^4698$</field>
    <description>Windows: a scheduled task was created (Security 4698) — real eventchannel.</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>
  <rule id="100125" level="8">
    <decoded_as>json</decoded_as>
    <field name="win.system.eventID" type="pcre2">^4698$</field>
    <description>Windows: a scheduled task was created (Security 4698) — generator json.</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <rule id="100121" level="12">
    <if_sid>100120,100125</if_sid>
    <field name="win.eventdata.taskContent" type="pcre2">(?i)powershell|pwsh|-enc|cmd\.exe|\.ps1|downloadstring|net\.webclient|invoke-expression</field>
    <description>Scheduled task registered to launch a suspicious interpreter/command.</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

</group>

<!-- ===================== Command and Control (DNS tunneling) ================= -->
<group name="detection_lab,suricata,dns,">

  <rule id="100300" level="10">
    <if_group>suricata</if_group>
    <field name="dns.rrtype">TXT</field>
    <field name="dns.rrname" type="pcre2">^[a-f0-9]{16,}\.</field>
    <description>Suspicious DNS TXT query with long hex subdomain (possible DNS tunneling / C2).</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
  </rule>

</group>

<!-- ===================== Phase 4: correlation / composite ==================== -->

<!-- SSH brute force -> successful login from the SAME source IP (compromise). -->
<group name="detection_lab,syslog,sshd,">

  <rule id="100400" level="12" timeframe="300">
    <if_sid>5715</if_sid>
    <if_matched_sid>5712</if_matched_sid>
    <same_source_ip />
    <description>SSH: successful login from an IP that was just brute-forcing (likely account compromise).</description>
    <mitre>
      <id>T1078</id>
      <id>T1110</id>
    </mitre>
  </rule>

</group>

<!-- DNS beaconing: aggregate repeated tunneling queries from one host into a
     single high-fidelity alert instead of one per query. -->
<group name="detection_lab,suricata,dns,">

  <rule id="100410" level="12" frequency="8" timeframe="600">
    <if_matched_sid>100300</if_matched_sid>
    <same_field>src_ip</same_field>
    <description>DNS beaconing: repeated long-subdomain TXT queries from one host (possible C2 over DNS).</description>
    <mitre>
      <id>T1071.004</id>
    </mitre>
  </rule>

</group>

<!-- Ingress tool transfer: a script/executable fetched over HTTP directly from a
     bare IP (no domain) is a strong download IOC. The bare-IP requirement keeps
     legitimate script fetches from CDNs/domains (e.g. raw.githubusercontent.com)
     from matching. -->
<group name="detection_lab,suricata,http,">

  <rule id="100310" level="12">
    <if_group>suricata</if_group>
    <field name="http.http_method">GET</field>
    <field name="http.url" type="pcre2">(?i)\.(ps1|psm1|exe|dll|bat|hta|vbs|scr)(\?|$)</field>
    <field name="http.hostname" type="pcre2">^\d{1,3}(\.\d{1,3}){3}$</field>
    <description>Script/executable downloaded over HTTP from a bare IP (ingress tool transfer).</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

</group>

<!-- Kill chain: encoded PowerShell execution followed by scheduled-task
     persistence on the SAME host within a short window. Correlates on
     win.system.computer (all Windows events arrive via one agent, so the agent
     name can't distinguish hosts). Tight timeframe so independent scenarios that
     merely happen on the same host don't look like a chain. -->
<group name="detection_lab,windows,killchain,">

  <rule id="100420" level="13" timeframe="600">
    <if_sid>100121</if_sid>
    <if_matched_sid>100101</if_matched_sid>
    <same_field>win.system.computer</same_field>
    <description>Kill chain: encoded PowerShell execution then scheduled-task persistence on the same host.</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- Download cradle confirmed: the SAME encoded-PowerShell process (correlated
       by processGuid, not host) opens an outbound network connection. Ties the
       execution to the ingress tool transfer with process-level precision. -->
  <rule id="100430" level="13" timeframe="300">
    <if_sid>100200,100205</if_sid>
    <if_matched_sid>100101</if_matched_sid>
    <same_field>win.eventdata.processGuid</same_field>
    <description>Download cradle: an encoded-PowerShell process made an outbound network connection.</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1105</id>
    </mitre>
  </rule>

</group>

<!-- ========================= Tuning / FP suppression ========================
  Rules that SILENCE a noisy vendor detection for a specific, provably benign
  generator. Separate ID block (100800+) and group so tuning is never confused
  with detection, and so an audit can answer "what have we deliberately stopped
  alerting on?" by reading one section.

  Rules for this block:
    * Suppress a GENERATOR, never a behaviour. Conditions must pin the writing
      process AND the artefact, so the exclusion cannot be inherited by
      anything else that happens to look similar.
    * Record the measured impact and the residual risk in the comment. A
      suppression with no stated blind spot has not been thought through.
    * Never suppress a whole rule to fix one noisy source.
========================================================================== -->
<group name="detection_lab,tuning,windows,">

  <!-- SEVERITY RECALIBRATION of vendor rule 92213 (was level 15).
       Level 15 is Wazuh's "severe attack" band and sits above NOTIFY_MIN_LEVEL
       (12), so every hit paged Slack. After 100800 removes the PowerShell probe
       noise, what remains is legitimate software writing executables to %TEMP% —
       Docker/Brave/Steam updaters, installers — measured at ~110 per 30 days.
       Those are benign TRUE positives: the rule is right, the activity is
       authorized. They deserve to stay visible and investigable, but they are
       not a reason to page a human at 3-4 alerts a day.

       Level 10 keeps it in the dashboard's "high (8-11)" band, above AI_MIN_LEVEL
       (8) so the triage scorer still ranks it, and above the score threshold once
       repetition is factored in — while stopping the paging.

       DELIBERATELY NOT SUPPRESSED: "an executable appeared in %TEMP%" is exactly
       how a real dropper looks. Silencing it to fix alert fatigue would trade a
       noisy detection for no detection.

       MAINTENANCE COST (accepted): `overwrite` pins a COPY of the vendor
       condition here, so an upstream change to 92213 will not reach us — this
       block must be re-checked when the Wazuh ruleset is bumped. The condition
       below is copied verbatim from
       ruleset/rules/0830-sysmon_id_11.xml; note its `\\\\`, which is what the
       eventchannel decoder's doubled backslashes actually require. Overwriting
       (rather than adding a lower-level child) keeps the alert's rule ID at
       92213, so the efficacy history and ATT&CK mapping stay continuous. -->
  <rule id="92213" level="10" overwrite="yes">
    <if_group>sysmon_event_11</if_group>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)[c-z]:\\\\Users\\\\.+\\\\AppData\\\\Local\\\\Temp\\\\.+\.(exe|com|dll|vbs|js|bat|cmd|pif|wsh|ps1|msi|vbe)</field>
    <options>no_full_log</options>
    <description>Executable file dropped in folder commonly used by malware</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>

  <!-- Vendor rule 92213 ("Executable file dropped in folder commonly used by
       malware", level 15) matches ANY of exe|dll|ps1|bat|... written under
       %LOCALAPPDATA%\Temp. PowerShell writes a script-policy probe file there
       every time it runs a script, to test AppLocker/script enforcement:
         C:\Users\<u>\AppData\Local\Temp\__PSScriptPolicyTest_<8>.<3>.ps1
       That is interpreter plumbing, not a file drop — the rule's premise does
       not hold, so this is a false positive rather than benign-but-real
       activity, and suppression (not a severity change) is the right fix.

       MEASURED: 389 of 499 alerts for 92213 over 30 days (78%) were this probe,
       all from AMIGO, all at level 15 — above NOTIFY_MIN_LEVEL, so every one
       paged Slack.

       SCOPE: both conditions are load-bearing. The writer must be powershell/
       pwsh AND the artefact must match .NET GetRandomFileName()'s exact 8.3
       shape under Temp. A real executable dropped by PowerShell still alerts;
       a probe-named file written by any other process still alerts.

       RESIDUAL RISK (accepted, documented): an attacker already executing as
       powershell.exe could name a dropped .ps1 to match this exact pattern and
       evade 92213. They must first have PowerShell execution, which 100101
       (encoded command line) and 100430 (download cradle) detect independently,
       and this suppression does not touch either.

       BACKSLASHES: events from the windows_eventchannel decoder carry path
       separators as DOUBLED backslashes, so `\\` (one literal backslash) only
       matches by luck on the final segment — which is why 100101's
       `\\powershell\.exe$` works. A multi-segment path written that way matches
       nothing at all, silently, and the suppression looks deployed while every
       alert keeps firing. Verified live: it did exactly that. `\\+` matches one
       or more separators, so the rule is correct on either encoding. -->
  <rule id="100800" level="0">
    <if_sid>92213</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\+(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)\\+AppData\\+Local\\+Temp\\+__PSScriptPolicyTest_[a-z0-9]{8}\.[a-z0-9]{3}\.ps1$</field>
    <description>PowerShell script-policy probe file in %TEMP% — benign interpreter plumbing, tuned out of 92213.</description>
    <group>false_positive,</group>
  </rule>

</group>
