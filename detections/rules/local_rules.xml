<!--
  Custom detection rules (detection-as-code). One <group> per ATT&CK tactic is
  added in Phase 3+. Custom rule IDs use the 100000+ range. Every rule carries a
  <mitre><id>Txxxx</id></mitre> block and has a matching test in detections/tests/.

  NOTE: analysisd treats a <group> containing zero <rule> elements as a fatal
  error ("Group without any rule"), which aborts the whole manager. So this file
  ships one harmless no-op rule to keep the group non-empty until Phase 3 adds
  real detections. Rule 100000 matches a program_name that never occurs and is
  level 0 (evaluated but never alerts).
-->
<group name="detection-lab,">
  <rule id="100000" level="0">
    <program_name>detection-lab-placeholder</program_name>
    <description>detection-lab placeholder (no-op); replaced by real rules in Phase 3</description>
  </rule>
</group>
